# FinAI cloud model configuration
# Never commit real API keys to source control.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Never commit real API keys to source control.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=FinAI
# Optional: allow OpenAI Responses API web-search tool for current research
OPENAI_WEB_SEARCH=0

# Read-only external financial-data ingestion. Do not commit real credentials.
FINANCIAL_DATASETS_API_KEY=
FINANCIAL_DATASETS_BASE_URL=https://api.financialdatasets.ai

# Longbridge OpenAPI read-only access (create credentials in the Longbridge developer portal).
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# Optional regional API routing: com, cn, or hk; see Longbridge SDK documentation.
LONGBRIDGE_REGION=

LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com

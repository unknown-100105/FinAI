# FinAI cloud model configuration
# Never commit real API keys to source control.

# Read-only external financial-data ingestion; check each provider's license/redistribution terms.
FINANCIAL_DATASETS_API_KEY=
FINANCIAL_DATASETS_BASE_URL=https://api.financialdatasets.ai

# Longbridge OpenAPI read-only access; the SDK also requires region/account permissions.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_REGION=
LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_DEEP_MODEL=
OPENAI_FAST_MODEL=
OPENAI_WEB_SEARCH=0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VERSION=2023-06-01

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=FinAI

# Optional deterministic operator preference, comma-separated model IDs.
FINAI_LLM_PREFERENCE=
# balanced | high | low
FINAI_LLM_COST_SENSITIVITY=balanced

# Adaptive execution constraints
FINAI_NETWORK_MODE=online
FINAI_DATA_SENSITIVITY=standard
FINAI_ALLOWED_PROVIDERS=

# Optional local-model locations. These must refer to existing files/directories;
# inference must not download large weights as a side effect of a user request.
FINAI_RLLM_MODEL_PATH=
FINAI_SARVAM_BASE_MODEL_PATH=
FINAI_EMBEDDING_MODEL_PATH=
# Optional explicit embedding device: cpu or cuda; blank means auto-detect.
FINAI_RAG_DEVICE=

# Optional external Colibrì inference engine. Leave base URL blank to disable.
# Install/configure the third-party Colibrì runtime separately; FinAI does not
# bundle its engine or model weights. Bind the server to loopback only.
FINAI_COLIBRI_BASE_URL=
FINAI_COLIBRI_MODEL=olmoe-colibri
FINAI_COLIBRI_API_KEY=
FINAI_COLIBRI_TIMEOUT_SECONDS=300

# Core API auth: development keeps local UI working; bearer protects all routes except /health.
# Set FINAI_ENV=production to fail closed unless a strong server-side token is configured.
FINAI_ENV=development
FINAI_API_AUTH_MODE=development
FINAI_API_BEARER_TOKEN=

# Experimental patent-mechanism research endpoints are off by default.
FINAI_ENABLE_RESEARCH_PATENT_ENDPOINTS=false

# Required if FINAI_ENABLE_RESEARCH_PATENT_ENDPOINTS=true; use a long random local-only token.
FINAI_RESEARCH_API_TOKEN=

# Opt in to the local persistent SwarmTrade paper ledger (never submits live orders).
FINAI_ENABLE_SWARMTRADE_PAPER_LEDGER=0
FINAI_SWARMTRADE_PAPER_DB=data/swarmtrade/paper_ledger.sqlite3
